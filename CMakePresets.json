{
    "version": 10,
    "configurePresets": [
        {
            "name": "msys2-ucrt",
            "description": "MSYS2_LOCATION by default would be 'C:/msys64'.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
                "CMAKE_C_COMPILER": "cc",
                "CMAKE_CXX_COMPILER": "c++"
            },
            "environment": {
                "MSYS2_LOCATION": "C:/msys64",
                "PATH": "$env{MSYS2_LOCATION}/ucrt64/bin;$env{MSYS2_LOCATION}/usr/local/bin;$env{MSYS2_LOCATION}/usr/bin;$penv{PATH}"
            }
        },
        {
            "name": "msys2-ucrt-RelWithDebInfo",
            "inherits": "msys2-ucrt",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "msys2-ucrt-Debug",
            "inherits": "msys2-ucrt",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "displayName": "RelWithDebInfo",
            "description": "",
            "configurePreset": "msys2-ucrt"
        }
    ]
}